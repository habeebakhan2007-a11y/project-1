@model IEnumerable<project_1.Models.User>
@{
    ViewData["Title"] = "User Directory";
}

<div class="card card-pia p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1"><i class="fa-solid fa-users me-2"></i>PIA Staff Directory</h3>
            <p class="text-muted mb-0">Authorized Admin Panel for Managing System Access</p>
        </div>
        <div>
            <a asp-action="AddUser" class="btn btn-pia-gold"><i class="fa-solid fa-user-plus me-1"></i> Add New Employee</a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary ms-2">Back to Dashboard</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark" style="background-color: #005A36;">
                <tr>
                    <th>ID</th>
                    <th>P:No</th>
                    <th>Full Name</th>
                    <th>Gmail / Email</th>
                    <th>Designation Role</th>
                    <th class="text-center">Action</th> <!-- Action Column Add Hua -->
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold">#@user.Id</td>
                        <td><span class="badge bg-light text-dark border">@user.PNo</span></td>
                        <td class="fw-semibold">@user.FullName</td>
                        <td><i class="fa-regular fa-envelope me-1 text-muted"></i>@user.Email</td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (user.Role == "General Manager")
                            {
                                <span class="badge bg-success">General Manager</span>
                            }
                            else if (user.Role == "Deputy GM")
                            {
                                <span class="badge bg-warning text-dark">Deputy GM</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Employee</span>
                            }
                        </td>
                        <!-- Assign Quota Button Add Hua -->
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-warning fw-bold text-dark" onclick="openQuotaModal('@user.PNo')">
                                <i class="fa-solid fa-sliders me-1"></i> Assign Quota
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Assign Leave Quota Modal -->
<div class="modal fade" id="assignQuotaModal" tabindex="-1" aria-labelledby="assignQuotaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold" id="assignQuotaModalLabel">
                    <i class="fa-solid fa-sliders me-2"></i>Assign Leave Quota - Admin
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="assignQuotaForm">
                @Html.AntiForgeryToken()

                <!-- User PNo Pass karne Ke Liye Hidden Field -->
                <input type="hidden" id="modalPNo" name="pno" value="" />

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Casual Leaves</label>
                            <input type="number" class="form-control" name="casualQuota" id="casualQuota" value="5" min="0" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Medical Leaves</label>
                            <input type="number" class="form-control" name="medicalQuota" id="medicalQuota" value="5" min="0" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Annual Leaves</label>
                            <input type="number" class="form-control" name="annualQuota" id="annualQuota" value="5" min="0" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Emergency Leaves</label>
                            <input type="number" class="form-control" name="emergencyQuota" id="emergencyQuota" value="5" min="0" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark">Save Quotas</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Modal Open handler with target User PNo
        function openQuotaModal(pno) {
            $('#modalPNo').val(pno);
            $('#assignQuotaModal').modal('show');
        }

        // 2. AJAX Form Submit Handler
        $('#assignQuotaForm').on('submit', function(e) {
            e.preventDefault();

            $.ajax({
                url: '/Account/AssignLeaveBalance',
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        $('#assignQuotaModal').modal('hide');
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while saving quota.');
                }
            });
        });
    </script>
}
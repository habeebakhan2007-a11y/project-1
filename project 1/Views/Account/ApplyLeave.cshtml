@model project_1.Models.LeaveApplication

@{
    ViewData["Title"] = "Apply for Leave";
}

<div class="container my-3" style="max-width: 900px;">
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">

        <!-- Header with Integrated Total Badge -->
        <div class="card-header bg-success text-white py-2 px-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="bi bi-file-earmark-plus me-1"></i>Apply for Leave</h6>
            <div class="badge bg-white text-success px-3 py-1 fs-6 shadow-sm">
                Total Remaining: <strong>@ViewBag.TotalAvailable Days</strong>
            </div>
        </div>

        <div class="card-body p-3">

            <!-- Quotas Grid (Casual, Medical, Annual Only) -->
            <div class="row g-2 mb-3 text-center">
                <div class="col-4">
                    <div class="p-2 border rounded-3 bg-light">
                        <span class="text-muted d-block small fw-semibold">Casual</span>
                        <span class="fs-5 fw-bold text-primary">@ViewBag.CasualBalance</span>
                        @* <span class="text-muted small">/ 5</span> *@
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 border rounded-3 bg-light">
                        <span class="text-muted d-block small fw-semibold">Medical</span>
                        <span class="fs-5 fw-bold text-warning">@ViewBag.MedicalBalance</span>
                        @* <span class="text-muted small">/ 5</span> *@
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 border rounded-3 bg-light">
                        <span class="text-muted d-block small fw-semibold">Annual</span>
                        <span class="fs-5 fw-bold text-success">@ViewBag.AnnualBalance</span>
                        @* <span class="text-muted small">/ 5</span> *@
                    </div>
                </div>
            </div>

            <!-- Form -->
            <form asp-action="ApplyLeave" method="post">
                <div class="row g-2">

                    <div class="col-md-4">
                        <label asp-for="StartDate" class="form-label small fw-semibold mb-1">From Date <span class="text-danger">*</span></label>
                        <input asp-for="StartDate" id="startDate" type="date" class="form-control form-control-sm" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EndDate" class="form-label small fw-semibold mb-1">To Date <span class="text-danger">*</span></label>
                        <input asp-for="EndDate" id="endDate" type="date" class="form-control form-control-sm" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Total Days</label>
                        <input type="text" id="totalDays" class="form-control form-control-sm bg-light" value="0 Days" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeaveType" class="form-label small fw-semibold mb-1">Leave Type <span class="text-danger">*</span></label>
                        <select asp-for="LeaveType" class="form-select form-select-sm" required>
                            <option value="">Select Leave Type...</option>
                            <option value="Casual Leave">Casual Leave</option>
                            <option value="Medical Leave">Medical Leave</option>
                            <option value="Annual Leave">Annual Leave</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ManagerPNo" class="form-label small fw-semibold mb-1">Forward <span class="text-danger">*</span></label>
                        <select asp-for="ManagerPNo" class="form-select form-select-sm" required>
                            <option value="">Forward...</option>
                            @if (ViewBag.Managers != null)
                            {
                                foreach (var mgr in ViewBag.Managers)
                                {
                                    <option value="@mgr.PNo">@mgr.FullName (@mgr.Role)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CityOnLeave" class="form-label small fw-semibold mb-1">City on Leave</label>
                        <input asp-for="CityOnLeave" type="text" class="form-control form-control-sm" placeholder="e.g. Karachi, Lahore" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContactNo" class="form-label small fw-semibold mb-1">Contact No <span class="text-danger">*</span></label>
                        <input asp-for="ContactNo"
                               type="tel"
                               class="form-control form-control-sm"
                               placeholder="e.g. 03001234567"
                               maxlength="11"
                               pattern="[0-9]{11}"
                               onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                               required />
                        <span asp-validation-for="ContactNo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AddressOnLeave" class="form-label small fw-semibold mb-1">Address on Leave</label>
                        <textarea asp-for="AddressOnLeave" class="form-control form-control-sm" rows="2" placeholder="Complete address during leave..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Reason" class="form-label small fw-semibold mb-1">Detailed Reason <span class="text-danger">*</span></label>
                        <textarea asp-for="Reason" class="form-control form-control-sm" rows="2" placeholder="Specify reason..." required></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a asp-action="Dashboard" class="btn btn-sm btn-light border px-3">Cancel</a>
                    <button type="submit" class="btn btn-sm btn-success px-4">Submit Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const startInput = document.getElementById("startDate");
            const endInput = document.getElementById("endDate");
            const totalDaysInput = document.getElementById("totalDays");

            function calculateDays() {
                const startVal = startInput.value;
                const endVal = endInput.value;

                if (startVal && endVal) {
                    const start = new Date(startVal);
                    const end = new Date(endVal);

                    if (end >= start) {
                        const diffTime = Math.abs(end - start);
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                        totalDaysInput.value = diffDays + (diffDays === 1 ? " Day" : " Days");
                    } else {
                        totalDaysInput.value = "Invalid Date Range";
                    }
                } else {
                    totalDaysInput.value = "0 Days";
                }
            }

            startInput.addEventListener("change", calculateDays);
            endInput.addEventListener("change", calculateDays);
        });
    </script>
}